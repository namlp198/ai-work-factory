# One consistent copy of the control-plane database into @REPO@/var/backups (keeps the newest 14):
# SQLite online copy (awf-*.db) or pg_dump custom format (awf-*.dump) when DATABASE_URL is PostgreSQL.
[Unit]
Description=AI Work Factory database backup
After=postgresql.service

[Service]
Type=oneshot
User=@USER@
Group=@GROUP@
WorkingDirectory=@REPO@
ExecStart=@REPO@/.venv/bin/awf db backup --keep 14
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
