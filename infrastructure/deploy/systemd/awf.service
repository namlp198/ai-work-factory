# AI Work Factory — runs whatever AWF_ROLE in .env says (control-plane, worker or all).
# Installed by scripts/install-systemd.sh, which replaces @REPO@, @USER@ and @GROUP@.
#
#   systemctl status awf          journalctl -u awf -f          sudo systemctl restart awf

[Unit]
Description=AI Work Factory (awf start)
Documentation=file://@REPO@/docs/HUONG_DAN_SU_DUNG.md
Wants=network-online.target
After=network-online.target
# Give up only if it crash-loops: 10 failures within 5 minutes.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@REPO@
# awf loads @REPO@/.env itself; nothing secret lives in this unit file.
ExecStart=@REPO@/.venv/bin/awf start
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5
# uvicorn shuts down gracefully on SIGTERM; give in-flight requests time to finish.
TimeoutStopSec=30

# Hardening that does not get in the way of builds (workers write caches under $HOME).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
