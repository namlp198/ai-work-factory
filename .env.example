# Per-machine configuration. This is the ONLY file that differs between machines.
# Create it with:  awf env init --role <all|control-plane|worker> [...]   (never commit .env)

# ---------------------------------------------------------------- role of this machine
# all            control plane + a local worker on one machine (development, small setups)
# control-plane  API + dashboard + orchestrator (+ database); workers run on other machines
# worker         execution node that connects to AWF_CONTROL_URL
AWF_ROLE=all
AWF_ENVIRONMENT=development

# ---------------------------------------------------------------- control plane
# 0.0.0.0 exposes the API on the LAN; requires both tokens below (enforced at startup).
AWF_API_HOST=127.0.0.1
AWF_API_PORT=8000
AWF_API_TOKEN=
AWF_WORKER_REGISTRATION_TOKEN=
# Relative SQLite paths resolve against the repository root. PostgreSQL for a 24/7 central server
# (sudo scripts/install-postgres.sh sets this line for you):
# DATABASE_URL=postgresql+psycopg://awf:<password>@127.0.0.1:5432/awf
DATABASE_URL=sqlite:///./var/awf.db
AWF_OBJECT_STORE=local
# AWF_S3_ENDPOINT=http://minio-host:9000
# AWF_S3_BUCKET=awf-artifacts
AWF_EMBEDDED_ORCHESTRATOR=false
# A run moves to another matching machine when its machine has been offline this long (seconds).
# AWF_RUN_REASSIGN_AFTER_SECONDS=600

# ---------------------------------------------------------------- notifications (control plane)
# Links in messages open this URL (the dashboard as your phone reaches it, e.g. over Tailscale).
# AWF_PUBLIC_URL=https://factory.example.com
# AWF_NOTIFY_EVENTS=approval,approval_resolved,failed,completed,worker_offline,run_moved
# Telegram: @BotFather -> /newbot; then message the bot /start to learn your chat id and user id.
# AWF_TELEGRAM_BOT_TOKEN=
# AWF_TELEGRAM_CHAT_IDS=
# AWF_TELEGRAM_APPROVERS=
# WhatsApp Business Cloud API (Meta):
# AWF_WHATSAPP_TOKEN=
# AWF_WHATSAPP_PHONE_NUMBER_ID=
# AWF_WHATSAPP_TO=84901234567
# AWF_WHATSAPP_TEMPLATE=
# Zalo Official Account:
# AWF_ZALO_APP_ID=
# AWF_ZALO_APP_SECRET=
# AWF_ZALO_REFRESH_TOKEN=
# AWF_ZALO_USER_IDS=

# ---------------------------------------------------------------- worker
AWF_CONTROL_URL=http://127.0.0.1:8000
# Defaults: name = hostname, platform/capabilities = auto-detected, workspaces under ./var/workspaces
# AWF_WORKER_NAME=
# AWF_WORKER_PLATFORM=linux-arm64
# AWF_WORKER_CAPABILITIES replaces detection; AWF_WORKER_EXTRA_CAPABILITIES adds to it.
# AWF_WORKER_CAPABILITIES=git,python,cmake,cuda,realsense
# AWF_WORKER_EXTRA_CAPABILITIES=realsense,robo-station-sdk
# AWF_WORKER_LABELS=location=lab,device=jetson-orin,preferred_for=robo-station
# AWF_WORKSPACE_ROOT=var/workspaces
# Jobs executed at the same time on this machine (one thread + one workspace each). Default 1.
# AWF_WORKER_MAX_JOBS=3

# ---------------------------------------------------------------- hosted git (control plane, ADR-016)
# Password people use for `git push factory ...` (any user name). Unset: generated once into <git root>/.token.
# AWF_GIT_TOKEN=
# Where project repositories live on the control plane (back it up; `awf db backup` bundles them):
# AWF_GIT_ROOT=./var/git
# GitHub token for the mirrors (ADR-017): fine-grained, Contents: read and write on the mirrored repositories only.
# AWF_MIRROR_TOKEN=
# awf/run-* branches of failed, cancelled or unmerged runs are deleted after this many days (merged ones at once):
# AWF_STALE_BRANCH_DAYS=14

# ---------------------------------------------------------------- models (worker machines)
# Agents run on workers, so model credentials belong on worker machines only. The worker announces
# llm-anthropic / llm-google for the keys it has; runs using a provider only go to machines with its key.
# ANTHROPIC_API_KEY=
# Claude Code as a coding engine (coding_engine: claude-code) needs the `claude` CLI on PATH; set this when it is
# installed elsewhere:
# AWF_CLAUDE_CODE_BIN=
# How Claude Code pays: api-key (default when ANTHROPIC_API_KEY is set) or login (the Claude Pro/Max account signed
# in once with `claude`; no API key is passed). With engine_scope=all a whole run can go through the plan:
# AWF_CLAUDE_CODE_AUTH=login
# A model the plan offers, when it has no access to the routed one (e.g. sonnet):
# AWF_CLAUDE_CODE_MODEL=
# GEMINI_API_KEY=
# ChatGPT models (OpenAI API, platform.openai.com) and the Codex coding engine:
# OPENAI_API_KEY=
# AWF_CODEX_BIN=
# Qwen (Alibaba Model Studio), Kimi (Moonshot), DeepSeek, MiniMax: OpenAI-compatible APIs. China-region accounts
# also set AWF_QWEN_BASE_URL / AWF_KIMI_BASE_URL / AWF_MINIMAX_BASE_URL (see guide §6).
# DASHSCOPE_API_KEY=
# MOONSHOT_API_KEY=
# DEEPSEEK_API_KEY=
# MINIMAX_API_KEY=
# Coding engines that sign in on their own: Antigravity (`agy`, Google account / Google AI Pro), Kimi Code
# (`kimi` /login) and MiniMax Code (`mcode login`). DeepSeek Harness (`dsh`) reads DEEPSEEK_API_KEY. Optional: pin the model; point at the executables when they are not on PATH.
# AWF_ANTIGRAVITY_BIN=
# AWF_ANTIGRAVITY_MODEL=
# AWF_KIMI_CODE_BIN=
# AWF_KIMI_CODE_MODEL=
# AWF_QWEN_CODE_BIN=
# AWF_DEEPSEEK_HARNESS_BIN=
# AWF_MINIMAX_CODE_BIN=
# AWF_MINIMAX_CODE_MODEL=
# AWF_QWEN_CODE_SANDBOX=1
# Offline deterministic agents (demos, integration checks):
# AWF_MODEL_PROVIDER=scripted
# AWF_SCRIPTED_RESPONSES=examples/demo/scripted-responses.yaml
