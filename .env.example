# Per-machine configuration. This is the ONLY file that differs between machines.
# Create it with:  awf env init --role <all|control-plane|worker> [...]   (never commit .env)

# ---------------------------------------------------------------- role of this machine
# all            control plane + a local worker on one machine (development, small setups)
# control-plane  API + dashboard + orchestrator (+ database); workers run on other machines
# worker         execution node that connects to AWF_CONTROL_URL
AWF_ROLE=all
AWF_ENVIRONMENT=development

# ---------------------------------------------------------------- control plane
# 0.0.0.0 exposes the API on the LAN; requires both tokens below (enforced at startup).
AWF_API_HOST=127.0.0.1
AWF_API_PORT=8000
AWF_API_TOKEN=
AWF_WORKER_REGISTRATION_TOKEN=
# Relative SQLite paths resolve against the repository root. PostgreSQL for shared setups:
# DATABASE_URL=postgresql+psycopg://awf:<password>@db-host:5432/awf
DATABASE_URL=sqlite:///./var/awf.db
AWF_OBJECT_STORE=local
# AWF_S3_ENDPOINT=http://minio-host:9000
# AWF_S3_BUCKET=awf-artifacts
AWF_EMBEDDED_ORCHESTRATOR=false
# A run moves to another matching machine when its machine has been offline this long (seconds).
# AWF_RUN_REASSIGN_AFTER_SECONDS=600

# ---------------------------------------------------------------- worker
AWF_CONTROL_URL=http://127.0.0.1:8000
# Defaults: name = hostname, platform/capabilities = auto-detected, workspaces under ./var/workspaces
# AWF_WORKER_NAME=
# AWF_WORKER_PLATFORM=linux-arm64
# AWF_WORKER_CAPABILITIES replaces detection; AWF_WORKER_EXTRA_CAPABILITIES adds to it.
# AWF_WORKER_CAPABILITIES=git,python,cmake,cuda,realsense
# AWF_WORKER_EXTRA_CAPABILITIES=realsense,robo-station-sdk
# AWF_WORKER_LABELS=location=lab,device=jetson-orin,preferred_for=robo-station
# AWF_WORKSPACE_ROOT=var/workspaces

# ---------------------------------------------------------------- models (worker machines)
# Agents run on workers, so Claude credentials belong on worker machines only.
# ANTHROPIC_API_KEY=
# Offline deterministic agents (demos, integration checks):
# AWF_MODEL_PROVIDER=scripted
# AWF_SCRIPTED_RESPONSES=examples/demo/scripted-responses.yaml
