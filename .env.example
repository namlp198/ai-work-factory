# Copy to .env and fill in. Never commit .env.
AWF_ENVIRONMENT=development

# Admin API token for the dashboard / API (required outside development).
AWF_API_TOKEN=change-me-admin-token
# Shared secret a worker presents once to register; it then receives its own token.
AWF_WORKER_REGISTRATION_TOKEN=change-me-registration-token

# Database: SQLite for local dev, PostgreSQL (+pgvector) via docker-compose.
DATABASE_URL=sqlite:///./var/awf.db
# DATABASE_URL=postgresql+psycopg://awf:awf@localhost:5432/awf

# Artifact store: local filesystem or s3 (MinIO).
AWF_OBJECT_STORE=local
# AWF_S3_ENDPOINT=http://localhost:9000
# AWF_S3_BUCKET=awf-artifacts

# Model provider. Unset = use config/model-routing.yaml (Claude). "scripted" = offline deterministic.
# AWF_MODEL_PROVIDER=scripted
# Claude credentials live on the WORKER only (agents run on workers), never in prompts or logs.
# ANTHROPIC_API_KEY=

# Run the orchestrator loop inside the API process (single-process dev setup).
AWF_EMBEDDED_ORCHESTRATOR=false
